# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/v1

# Security & Secrets
JWT_SECRET=super_secret_jwt_random_32_characters_key_here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database & Cache (PostgreSQL 15 + Redis)
DATABASE_URL=postgres://velvet:veil_secret_password@localhost:5432/velvet_veil
REDIS_URL=redis://localhost:6379

# SMS Auth Provider (Twilio Mock or Live)
TWILIO_ACCOUNT_SID=AC_MOCK_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=MOCK_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=+15550001234

# Push Notifications (Wake-up ping only - no content/sender)
FCM_SERVER_KEY=MOCK_FCM_SERVER_KEY_HERE
